# ---------------------------------------------------------------------------
# Line ending normalisation.
#
# The whole repository uses LF in the git index, including the files generated
# for clients: a file with CRLF breaks shell hooks and container scripts on
# Linux.
# ---------------------------------------------------------------------------
* text=auto eol=lf

# Files that must keep CRLF no matter what (Windows scripts).
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries: git must not try to convert them or show text diffs.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated files: excluded from GitHub language statistics and collapsed by
# default in Pull Request reviews.
pnpm-lock.yaml linguist-generated=true -diff
